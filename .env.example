# Copy to .env and fill in. Used for local runs (nix-shell, npm run sync-vercel, etc.).
# In GitLab CI, set these in Settings → CI/CD → Variables instead.

# Required for sync-vercel and deploy-docs
DOCS_VERCEL_TOKEN=

# Optional: for npm run dns and for Vercel domain TXT verification in sync-vercel
DOCS_CLOUDFLARE_API_TOKEN=

# Optional: only if using a Vercel team
# DOCS_VERCEL_TEAM_ID=

# Not needed in .env: DOCS_REF / DOCS_SHA (set by CI or when running deploy-docs: DOCS_SHA=xxx npm run deploy-docs)
# GITLAB_TOKEN: only in CI if docs repo is private in another project (for get-latest-docs-ref-sha and short-SHA resolve)
